# Sao chép file này thành .env rồi điền giá trị thật.
# Không commit file .env lên GitHub.

# API key Gemini — lấy tại https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key-here

# Giữ = 0 nếu dùng Google AI Studio (không dùng Vertex AI)
GOOGLE_GENAI_USE_VERTEXAI=0

# --- Mở rộng (tuỳ chọn, chỉ cần nếu chạy src/api_server.py + frontend/) ---
# Token bí mật để Web UI xác thực khi gọi /api/chat/action (approve/reject ticket HITL).
# Tự sinh 1 chuỗi ngẫu nhiên, ví dụ: python -c "import secrets; print(secrets.token_hex(24))"
HITL_ADMIN_TOKEN=change-me-to-a-random-secret
# TELE_BOT_TOKEN=
# TELE_BOT_ID=
