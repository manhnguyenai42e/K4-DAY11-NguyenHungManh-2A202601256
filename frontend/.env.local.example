# Sao chép thành frontend/.env.local (KHÔNG commit file .env.local lên GitHub).
#
# Backend FastAPI chạy ở đâu (route handler /api/hitl-action sẽ proxy tới đây)
BACKEND_URL=http://localhost:14001

# Phải khớp CHÍNH XÁC HITL_ADMIN_TOKEN ở .env của backend (thư mục gốc repo).
# QUAN TRỌNG: không thêm tiền tố NEXT_PUBLIC_ — biến này chỉ được đọc trong
# route handler server-side (frontend/src/app/api/hitl-action/route.ts),
# không bao giờ được bundle ra JS phía trình duyệt.
HITL_ADMIN_TOKEN=change-me-to-a-random-secret
